{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "djshakeywakey.co.uk" }],
      "destination": "https://www.djshakeywakey.co.uk/$1",
      "permanent": true
    },
    { "source": "/projects/", "destination": "/events", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/events/", "destination": "/events", "permanent": true },
    { "source": "/contact/", "destination": "/contact", "permanent": true }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/contact", "destination": "/contact.html" }
  ]
}
